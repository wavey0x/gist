#!/usr/bin/env python3
"""Create, update, read, and check access to Wavey Gists."""

from __future__ import annotations

import argparse
import json
import mimetypes
import os
import re
import secrets
import shlex
import subprocess
import sys
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from pathlib import Path


DEFAULT_API_BASE_URL = "https://api.wavey.info"
KEYCHAIN_SERVICE = "wavey-api:gist"
GIST_ID_PATTERN = r"[A-Za-z0-9]{16,64}"
GIST_ID_RE = re.compile(rf"^{GIST_ID_PATTERN}$")
GIST_PATH_RE = re.compile(
    rf"^/(?P<gist_id>{GIST_ID_PATTERN})"
    r"(?:/revisions/(?P<revision_number>[1-9][0-9]*))?/?$"
)
SHA256_RE = re.compile(r"^[a-f0-9]{64}$")
PLACEHOLDER_PREFIXES = ("your_", "your-", "changeme", "xxx", "todo")
USER_AGENT = "wavey-gist-publish-cli"


class CliError(RuntimeError):
    pass


class ApiError(CliError):
    def __init__(self, status: int, code: str | None, message: str):
        self.status = status
        self.code = code
        self.message = message
        detail = f"{code}: {message}" if code else message
        super().__init__(f"Wavey API error {status}: {detail}")


class AmbiguousWriteError(CliError):
    pass


@dataclass(frozen=True)
class ImageUpload:
    filename: str
    content: bytes
    content_type: str


@dataclass(frozen=True)
class Snapshot:
    gist_id: str
    url: str
    title: str | None
    revision_number: int
    latest_revision_number: int
    snapshot_sha256: str
    primary_file: str
    display_title: str
    files: dict[str, str]


def is_real_secret(value: str | None) -> bool:
    token = (value or "").strip()
    low = token.lower()
    return bool(token) and not any(
        low.startswith(prefix) or low == prefix for prefix in PLACEHOLDER_PREFIXES
    )


def token_from_env() -> str | None:
    token = os.environ.get("WAVEY_GIST_API_KEY")
    return token.strip() if is_real_secret(token) else None


def token_from_env_file() -> str | None:
    path = Path(
        os.environ.get("WAVEY_GIST_ENV_FILE", "~/.config/wavey/gist.env")
    ).expanduser()
    if not path.exists():
        return None
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            text = line.strip()
            if not text or text.startswith("#"):
                continue
            if text.startswith("export "):
                text = text[len("export ") :].strip()
            if "=" not in text:
                continue
            key, value = text.split("=", 1)
            if key.strip() != "WAVEY_GIST_API_KEY":
                continue
            parts = shlex.split(value, posix=True)
            token = parts[0] if parts else value.strip()
            if is_real_secret(token):
                return token.strip()
    except (OSError, UnicodeError, ValueError):
        return None
    return None


def token_from_keychain() -> str | None:
    account = os.environ.get("USER", "")
    service = os.environ.get("WAVEY_GIST_KEYCHAIN_SERVICE", KEYCHAIN_SERVICE)
    command = ["security", "find-generic-password", "-s", service, "-w"]
    if account:
        command[2:2] = ["-a", account]
    try:
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    token = result.stdout.strip()
    return token if result.returncode == 0 and is_real_secret(token) else None


def wavey_token() -> str | None:
    return token_from_env() or token_from_env_file() or token_from_keychain()


def parse_gist_target(value: str) -> tuple[str, int | None]:
    text = value.strip()
    if GIST_ID_RE.fullmatch(text):
        return text, None

    parsed = urllib.parse.urlparse(text)
    match = GIST_PATH_RE.fullmatch(parsed.path)
    if (
        parsed.scheme not in {"http", "https"}
        or not parsed.netloc
        or parsed.username is not None
        or parsed.password is not None
        or parsed.params
        or parsed.query
        or parsed.fragment
        or match is None
    ):
        raise CliError("Expected a Wavey gist id or latest/revision URL.")
    revision = match.group("revision_number")
    return match.group("gist_id"), int(revision) if revision else None


def published_name(value: str) -> str:
    filename = unicodedata.normalize("NFC", Path(value).name)
    if not filename:
        raise CliError(f"File path has no basename: {value}")
    return filename


def read_text_files(paths: list[str]) -> dict[str, str]:
    files: dict[str, str] = {}
    collision_keys: set[str] = set()
    for value in paths:
        path = Path(value)
        if not path.is_file():
            raise CliError(f"Text file does not exist or is not a file: {value}")
        filename = published_name(value)
        collision_key = filename.casefold()
        if collision_key in collision_keys:
            raise CliError(f"Duplicate or case-colliding basename: {filename}")
        content = path.read_bytes().decode("utf-8")
        files[filename] = content.replace("\r\n", "\n").replace("\r", "\n")
        collision_keys.add(collision_key)
    return files


def read_image_uploads(paths: list[str]) -> list[ImageUpload]:
    uploads: list[ImageUpload] = []
    collision_keys: set[str] = set()
    for value in paths:
        path = Path(value)
        if not path.is_file():
            raise CliError(f"Image file does not exist or is not a file: {value}")
        filename = published_name(value)
        collision_key = filename.casefold()
        if collision_key in collision_keys:
            raise CliError(f"Duplicate or case-colliding image basename: {filename}")
        uploads.append(
            ImageUpload(
                filename=filename,
                content=path.read_bytes(),
                content_type=mimetypes.guess_type(filename)[0]
                or "application/octet-stream",
            )
        )
        collision_keys.add(collision_key)
    return uploads


def encode_multipart_form_data(
    payload: dict,
    image_uploads: list[ImageUpload],
) -> tuple[str, bytes]:
    boundary = f"----waveygist{secrets.token_hex(16)}"
    boundary_bytes = boundary.encode("ascii")
    chunks = [
        b"--" + boundary_bytes + b"\r\n",
        b'Content-Disposition: form-data; name="payload"\r\n',
        b"Content-Type: application/json; charset=utf-8\r\n\r\n",
        json.dumps(payload).encode("utf-8"),
        b"\r\n",
    ]
    for upload in image_uploads:
        ascii_filename = (
            upload.filename.encode("ascii", errors="replace")
            .decode("ascii")
            .replace("\\", "\\\\")
            .replace('"', '\\"')
        )
        encoded_filename = urllib.parse.quote(upload.filename, safe="")
        chunks.extend(
            (
                b"--" + boundary_bytes + b"\r\n",
                (
                    "Content-Disposition: form-data; name=\"images[]\"; "
                    f'filename="{ascii_filename}"; '
                    f"filename*=UTF-8''{encoded_filename}\r\n"
                ).encode("ascii"),
                f"Content-Type: {upload.content_type}\r\n\r\n".encode("ascii"),
                upload.content,
                b"\r\n",
            )
        )
    chunks.extend((b"--" + boundary_bytes + b"--\r\n",))
    return f"multipart/form-data; boundary={boundary}", b"".join(chunks)


def _request(
    url: str,
    *,
    method: str = "GET",
    token: str | None = None,
    payload: dict | None = None,
    image_uploads: list[ImageUpload] | None = None,
) -> bytes:
    headers = {"Accept": "application/json", "User-Agent": USER_AGENT}
    body = None
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if payload is not None:
        if image_uploads:
            headers["Content-Type"], body = encode_multipart_form_data(
                payload, image_uploads
            )
        else:
            headers["Content-Type"] = "application/json"
            body = json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.read()
    except urllib.error.HTTPError as exc:
        response_body = exc.read().decode("utf-8", errors="replace")
        code = None
        message = response_body
        try:
            error = json.loads(response_body).get("error", {})
            if isinstance(error, dict):
                code = error.get("code")
                message = error.get("message") or response_body
        except (AttributeError, json.JSONDecodeError):
            pass
        raise ApiError(exc.code, code, message) from exc
    except (urllib.error.URLError, TimeoutError) as exc:
        if method in {"POST", "PATCH"}:
            raise AmbiguousWriteError(
                "Write outcome is unknown after a network failure; do not retry."
            ) from exc
        reason = getattr(exc, "reason", exc)
        raise CliError(f"Wavey API connection error: {reason}") from exc


def request_json(
    url: str,
    *,
    method: str = "GET",
    token: str | None = None,
    payload: dict | None = None,
    image_uploads: list[ImageUpload] | None = None,
) -> dict:
    body = _request(
        url,
        method=method,
        token=token,
        payload=payload,
        image_uploads=image_uploads,
    )
    try:
        parsed = json.loads(body.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        if method in {"POST", "PATCH"}:
            raise AmbiguousWriteError(
                "Write outcome is unknown because the API response was invalid; "
                "do not retry."
            ) from exc
        raise CliError("Wavey API returned invalid JSON.") from exc
    if not isinstance(parsed, dict) and method in {"POST", "PATCH"}:
        raise AmbiguousWriteError(
            "Write outcome is unknown because the API response was invalid; "
            "do not retry."
        )
    if not isinstance(parsed, dict):
        raise CliError("Wavey API returned a non-object JSON response.")
    return parsed


def parse_snapshot(data: dict, expected_id: str | None = None) -> Snapshot:
    gist_id = data.get("id")
    url = data.get("url")
    title = data.get("title")
    revision_number = data.get("revision_number")
    latest_revision_number = data.get("latest_revision_number")
    digest = data.get("snapshot_sha256")
    primary_file = data.get("primary_file")
    display_title = data.get("display_title")
    raw_files = data.get("files")
    if (
        not isinstance(gist_id, str)
        or not GIST_ID_RE.fullmatch(gist_id)
        or (expected_id is not None and gist_id != expected_id)
        or not isinstance(url, str)
        or not (title is None or isinstance(title, str))
        or not isinstance(revision_number, int)
        or isinstance(revision_number, bool)
        or revision_number < 1
        or not isinstance(latest_revision_number, int)
        or isinstance(latest_revision_number, bool)
        or latest_revision_number < revision_number
        or not isinstance(digest, str)
        or not SHA256_RE.fullmatch(digest)
        or not isinstance(primary_file, str)
        or not isinstance(display_title, str)
        or not isinstance(raw_files, dict)
        or primary_file not in raw_files
    ):
        raise CliError("Wavey API returned an invalid gist response.")
    url_id, url_revision = parse_gist_target(url)
    if url_id != gist_id or url_revision is not None:
        raise CliError("Wavey API returned an invalid gist URL.")

    files: dict[str, str] = {}
    for filename, file_data in raw_files.items():
        if (
            not isinstance(filename, str)
            or not isinstance(file_data, dict)
            or not isinstance(file_data.get("content"), str)
        ):
            raise CliError("Wavey API returned an invalid gist response.")
        files[filename] = file_data["content"]
    return Snapshot(
        gist_id=gist_id,
        url=url,
        title=title,
        revision_number=revision_number,
        latest_revision_number=latest_revision_number,
        snapshot_sha256=digest,
        primary_file=primary_file,
        display_title=display_title,
        files=files,
    )


def read_public_snapshot(
    api_base_url: str, gist_id: str, revision_number: int | None
) -> Snapshot:
    if revision_number is None:
        path = f"/api/v1/gists/{gist_id}/render"
    else:
        path = f"/api/v1/gists/{gist_id}/revisions/{revision_number}/render"
    snapshot = parse_snapshot(request_json(f"{api_base_url}{path}"), gist_id)
    if revision_number is not None and snapshot.revision_number != revision_number:
        raise CliError("Wavey API returned the wrong gist revision.")
    return snapshot


def read_owned_snapshot(api_base_url: str, gist_id: str, token: str) -> Snapshot:
    data = request_json(
        f"{api_base_url}/api/v1/gists/{gist_id}",
        token=token,
    )
    return parse_snapshot(data, gist_id)


def compact_snapshot(snapshot: Snapshot) -> dict:
    return {
        "id": snapshot.gist_id,
        "url": snapshot.url,
        "title": snapshot.title,
        "display_title": snapshot.display_title,
        "primary_file": snapshot.primary_file,
        "snapshot_sha256": snapshot.snapshot_sha256,
        "revision_number": snapshot.revision_number,
        "latest_revision_number": snapshot.latest_revision_number,
        "files": snapshot.files,
    }


def require_token() -> str:
    token = wavey_token()
    if not token:
        raise CliError(
            "Wavey Gist API key not found in WAVEY_GIST_API_KEY, the configured "
            f"environment file, or macOS Keychain service {KEYCHAIN_SERVICE}."
        )
    return token


def normalized_title(value: str) -> str | None:
    return value.strip() or None


def publish(
    api_base_url: str,
    *,
    method: str,
    path: str,
    token: str,
    payload: dict,
    images: list[ImageUpload],
    expected_id: str | None,
) -> Snapshot:
    data = request_json(
        f"{api_base_url}{path}",
        method=method,
        token=token,
        payload=payload,
        image_uploads=images,
    )
    try:
        return parse_snapshot(data, expected_id)
    except CliError as exc:
        raise AmbiguousWriteError(
            "Write may have succeeded but the API response was invalid; do not retry."
        ) from exc


def create_gist(
    api_base_url: str, args: argparse.Namespace, token: str
) -> Snapshot:
    files = read_text_files(args.files)
    images = read_image_uploads(args.image)
    payload: dict[str, object] = {
        "files": {
            filename: {"content": content} for filename, content in files.items()
        }
    }
    expected_title = None
    if hasattr(args, "title"):
        payload["title"] = args.title
        expected_title = normalized_title(args.title)
    published = publish(
        api_base_url,
        method="POST",
        path="/api/v1/gists",
        token=token,
        payload=payload,
        images=images,
        expected_id=None,
    )
    if not images and (
        published.files != files or published.title != expected_title
    ):
        raise CliError(
            "Published gist differs from the submitted files; do not retry: "
            f"{published.url} revision {published.revision_number}"
        )
    return published


def update_gist(
    api_base_url: str, args: argparse.Namespace, token: str
) -> Snapshot:
    gist_id, revision_number = parse_gist_target(args.target)
    if revision_number is not None:
        raise CliError("Update requires a latest gist URL or bare gist id.")
    overlays = read_text_files(args.files)
    images = read_image_uploads(args.image)
    title_is_present = hasattr(args, "title")
    if not overlays and not images and not args.delete and not title_is_present:
        raise CliError("Update requires a file, image, deletion, or title change.")
    current = read_owned_snapshot(api_base_url, gist_id, token)
    files = dict(current.files)
    files.update(overlays)
    for value in args.delete:
        filename = unicodedata.normalize("NFC", value)
        if filename in overlays:
            raise CliError(f"Cannot update and delete the same file: {filename}")
        if filename not in files:
            raise CliError(f"Cannot delete missing file: {filename}")
        del files[filename]

    expected_title = normalized_title(args.title) if title_is_present else current.title

    payload: dict[str, object] = {
        "files": {
            filename: {"content": content} for filename, content in files.items()
        },
        "expected_snapshot_sha256": current.snapshot_sha256,
    }
    if title_is_present:
        payload["title"] = args.title

    try:
        published = publish(
            api_base_url,
            method="PATCH",
            path=f"/api/v1/gists/{gist_id}",
            token=token,
            payload=payload,
            images=images,
            expected_id=gist_id,
        )
    except AmbiguousWriteError:
        if images:
            raise
        reconciled = read_owned_snapshot(api_base_url, gist_id, token)
        if reconciled.files != files or reconciled.title != expected_title:
            raise
        published = reconciled
    except ApiError as exc:
        if exc.status == 409:
            raise CliError("Gist changed while updating; read it and retry.") from exc
        raise

    if not images and (
        published.files != files or published.title != expected_title
    ):
        raise CliError(
            "Published gist differs from the submitted files; do not retry: "
            f"{published.url} revision {published.revision_number}"
        )
    return published


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    create = subparsers.add_parser("create", help="create a gist from local files")
    create.add_argument("files", nargs="+", metavar="FILE")
    create.add_argument("--image", action="append", default=[], metavar="IMAGE")
    create.add_argument("--title", default=argparse.SUPPRESS)

    update = subparsers.add_parser("update", help="update an owned gist")
    update.add_argument("target", metavar="GIST")
    update.add_argument("files", nargs="*", metavar="FILE")
    update.add_argument("--delete", action="append", default=[], metavar="NAME")
    update.add_argument("--image", action="append", default=[], metavar="IMAGE")
    update.add_argument(
        "--title",
        default=argparse.SUPPRESS,
        help="set the title; pass an empty string to clear it",
    )

    read = subparsers.add_parser("read", help="read a public gist as compact JSON")
    read.add_argument("target", metavar="GIST")

    subparsers.add_parser("check", help="check local write credentials")
    return parser


def api_base_url() -> str:
    value = os.environ.get("WAVEY_GIST_API_BASE_URL", DEFAULT_API_BASE_URL).rstrip("/")
    if not value:
        raise CliError("WAVEY_GIST_API_BASE_URL is empty.")
    return value


def _redact(text: str, token: str | None) -> str:
    return text.replace(token, "[REDACTED]") if token else text


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    token = None
    try:
        base_url = api_base_url()
        if args.command == "check":
            require_token()
            print("Wavey Gist API key found.")
            return 0
        if args.command == "read":
            gist_id, revision_number = parse_gist_target(args.target)
            snapshot = read_public_snapshot(base_url, gist_id, revision_number)
            print(
                json.dumps(
                    compact_snapshot(snapshot),
                    ensure_ascii=False,
                    sort_keys=True,
                )
            )
            return 0

        token = require_token()
        snapshot = (
            create_gist(base_url, args, token)
            if args.command == "create"
            else update_gist(base_url, args, token)
        )
        print(snapshot.url)
        return 0
    except (CliError, OSError, UnicodeError) as exc:
        print(_redact(str(exc), token), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
